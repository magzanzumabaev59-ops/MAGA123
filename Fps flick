-- ========== ВКЛАДКА "СКИНЫ" ==========
local originals = {}
local function resetSkin()
	for part, d in pairs(originals) do
		if part.Parent then
			part.Color, part.Material, part.Transparency = d.c, d.m, d.t
		end
	end
	originals = {}
end

local function applySkin(color, material, transparency)
	local char = player.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			if not originals[part] then
				originals[part] = { c = part.Color, m = part.Material, t = part.Transparency }
			end
			part.Color = color
			part.Material = material
			if transparency then part.Transparency = transparency end
		end
	end
end

