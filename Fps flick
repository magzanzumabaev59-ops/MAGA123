	local list = {
		{ "Золото", function() applySkin(Color3.fromRGB(255, 200, 40), Enum.Material.Metal) end },
		{ "Неон", function() applySkin(ACCENT, Enum.Material.Neon) end },
		{ "Лёд", function() applySkin(Color3.fromRGB(150, 220, 255), Enum.Material.Ice) end },
		{ "Призрак", function() applySkin(Color3.fromRGB(230, 230, 255), Enum.Material.ForceField, 0.3) end },
		{ "Лава", function() applySkin(Color3.fromRGB(255, 80, 20), Enum.Material.CrackedLava) end },
		{ "Сброс", resetSkin },
	}
	for _, item in ipairs(list) do
		local b = Instance.new("TextButton")
		b.BackgroundColor3 = PANEL
		b.Text = item[1]
		b.Font = Enum.Font.GothamMedium
